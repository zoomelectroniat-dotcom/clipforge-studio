# ClipForge Studio — environment variables.
# Copy to .env and fill in. Never commit real values.

# --- AI (required for transcription + highlight detection) ---
# Falls back to ~/workspace/clipforge-server/.groq_key when unset.
GROQ_API_KEY=

# --- Completion email (optional; app works without it) ---
# When SMTP_HOST is unset the mailer logs instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_USE_TLS=1

# --- Public URL used in email links ---
APP_URL=http://127.0.0.1:8901

# --- Google OAuth: "Sign in with Google" + private Drive imports (optional) ---
# Without these, the app works with email+password and public Drive links.
# GOOGLE_REDIRECT_URI must match EXACTLY what you enter in Google Cloud Console,
# e.g. http://127.0.0.1:8901/auth/google/callback (local) or
# https://your-domain.com/auth/google/callback (production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Stripe payments (optional; INACTIVE until all keys are pasted) ---
# Without STRIPE_SECRET_KEY, the pricing buttons only show
# "Payments aren't configured yet" and no charge is ever attempted.
# Create the two Products/Prices in the Stripe Dashboard, then paste:
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=
# From Developers -> Webhooks -> Add endpoint: <APP_URL>/billing/webhook
# (listen to the event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=
